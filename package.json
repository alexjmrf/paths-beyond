{
  "name": "paths-beyond",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "node scripts/check-no-random.mjs",
    "validate:data": "pnpm --filter @paths-beyond/data run validate:data",
    "sim": "tsx packages/sim-cli/src/cli.ts",
    "balance": "tsx tools/balance/src/cli.ts",
    "relatorio": "pnpm --filter @paths-beyond/server run relatorio",
    "test:browser": "pnpm --filter @paths-beyond/core run test:browser",
    "browsers:install": "pnpm --filter @paths-beyond/core exec playwright install --with-deps",
    "art": "tsx tools/art/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
