# M28, 1/N — as variáveis do servidor, e de onde cada uma vem.
#
# Este arquivo é um MODELO versionado; nenhum valor aqui é real. Copie para `.env` (que o
# `.gitignore` já ignora) e preencha.
#
# **O ambiente local não precisa disto.** `docker compose up` declara o que o servidor exige
# dentro do próprio `compose.yaml`. Este arquivo é para quem roda `pnpm --filter
# @paths-beyond/server start` — o `index.ts` de PRODUÇÃO — fora do compose.
#
# A lista canônica vive em `apps/server/src/env.ts`, e `apps/server/tests/ambiente.test.ts`
# confere que nenhum ponto de entrada lê uma variável que não esteja declarada lá.

# O banco. Sem ela o servidor não sobe (M19).
DATABASE_URL=postgres://paths:paths@127.0.0.1:5432/paths_beyond

# §9.4 — o segredo de onde a seed de batalha deriva. Sem ele o cliente escolheria a própria
# seed; o servidor falha ao subir em vez de cair num default previsível. Gere um valor longo
# e aleatório, e NÃO reaproveite o do compose.
BATTLE_TICKET_SECRET=

# M20 — a identidade de plataforma. Só produção: o ambiente local monta o validador de
# desenvolvimento, num ponto de entrada separado, porque numa máquina limpa não há Steam.
STEAM_WEB_API_KEY=
STEAM_APP_ID=

# Opcional; o padrão é 3000.
# PORT=3000
