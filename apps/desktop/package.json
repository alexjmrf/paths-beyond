{
  "name": "@paths-beyond/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.json",
    "build": "pnpm run build:renderer && pnpm run build:preload && pnpm run build:main",
    "typecheck": "tsc --noEmit",
    "determinismo": "electron dist/main.js --determinismo",
    "build:preload": "vite build --config vite.preload.config.ts",
    "empacotar": "electron-builder --dir",
    "empacotar:instalador": "electron-builder"
  },
  "dependencies": {
    "@paths-beyond/core": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.pathsbeyond.game",
    "productName": "Paths Beyond",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client"
      },
      {
        "from": "ambiente.json",
        "to": "ambiente.json"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.pathsbeyond.example/desktop/"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.strategy-games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
